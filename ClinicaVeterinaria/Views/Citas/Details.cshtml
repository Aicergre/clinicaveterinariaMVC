@model ClinicaVeterinaria.Models.Cita

@{
    ViewData["Title"] = "Detalle de Cita";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-5">


                    <div class="text-center mb-4">

                        <div style="font-size:70px;">
                            📅
                        </div>

                        <h2 class="fw-bold">
                            Detalle de la Cita
                        </h2>

                        <p class="text-muted">
                            Información de tu cita veterinaria.
                        </p>

                    </div>


                    <div class="row g-4">


                        <!-- MASCOTA -->

                        <div class="col-md-6">

                            <div class="p-3 bg-light rounded">

                                <small class="text-muted">
                                    Mascota
                                </small>

                                <h5 class="mb-0 mt-1">

                                    🐾 @Model.Mascota?.Nombre

                                </h5>

                            </div>

                        </div>


                        <!-- SERVICIO -->

                        <div class="col-md-6">

                            <div class="p-3 bg-light rounded">

                                <small class="text-muted">
                                    Servicio
                                </small>

                                <h5 class="mb-0 mt-1">

                                    @Model.ServicioVeterinario?.Nombre

                                </h5>

                            </div>

                        </div>


                        <!-- FECHA -->

                        <div class="col-md-6">

                            <div class="p-3 bg-light rounded">

                                <small class="text-muted">
                                    Fecha
                                </small>

                                <h5 class="mb-0 mt-1">

                                    @Model.Fecha.ToString(
                                        "dd/MM/yyyy"
                                    )

                                </h5>

                            </div>

                        </div>


                        <!-- HORA -->

                        <div class="col-md-6">

                            <div class="p-3 bg-light rounded">

                                <small class="text-muted">
                                    Hora
                                </small>

                                <h5 class="mb-0 mt-1">

                                    @Model.Fecha.ToString(
                                        "HH:mm"
                                    )

                                </h5>

                            </div>

                        </div>


                        <!-- ESTADO -->

                        <div class="col-12">

                            <div class="p-3 bg-light rounded">

                                <small class="text-muted">
                                    Estado
                                </small>

                                <div class="mt-2">

                                    @if (Model.Estado == "Pendiente")
                                    {
                                        <span class="badge bg-warning text-dark fs-6">

                                            Pendiente

                                        </span>
                                    }
                                    else if (Model.Estado == "Confirmada")
                                    {
                                        <span class="badge bg-primary fs-6">

                                            Confirmada

                                        </span>
                                    }
                                    else if (Model.Estado == "Atendida")
                                    {
                                        <span class="badge bg-success fs-6">

                                            Atendida

                                        </span>
                                    }
                                    else if (Model.Estado == "Cancelada")
                                    {
                                        <span class="badge bg-danger fs-6">

                                            Cancelada

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary fs-6">

                                            @Model.Estado

                                        </span>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- BOTONES -->

                    <div class="d-flex gap-2 mt-4">


                        <a asp-action="Index"
                           class="btn btn-secondary">

                            ← Volver

                        </a>


                        @if (Model.Estado != "Cancelada" &&
                             Model.Estado != "Atendida")
                        {
                            <form asp-controller="Citas"
                                  asp-action="Cancelar"
                                  asp-route-id="@Model.Id"
                                  method="post"
                                  onsubmit="return confirm('¿Estás seguro de que deseas cancelar esta cita?');">

                                <button type="submit"
                                        class="btn btn-danger">

                                    Cancelar cita

                                </button>

                            </form>
                        }

                    </div>


                    @if (Model.Estado == "Cancelada")
                    {
                        <div class="alert alert-secondary mt-4 mb-0">

                            Esta cita fue cancelada.

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>