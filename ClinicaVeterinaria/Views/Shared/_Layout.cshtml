<!DOCTYPE html>
 
<html lang="es">
 
<head>
 
    <meta charset="utf-8" />
 
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />
 
    <title>
        @ViewData["Title"] - VetCare
    </title>
 
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
 
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
 
</head>
 
 
<body>
 
<header>
 
    <nav class="navbar navbar-expand-lg navbar-dark vet-navbar">
 
        <div class="container-fluid px-lg-5">
 
            <a class="navbar-brand vet-brand"
               asp-controller="Home"
               asp-action="Index">
 
                <span class="brand-icon">
                    🐾
                </span>
 
                VetCare
 
            </a>
 
 
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarVet">
 
                <span class="navbar-toggler-icon"></span>
 
            </button>
 
 
            <div class="collapse navbar-collapse"
                 id="navbarVet">
 
 
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
 
 
                    @if (User.Identity != null &&
                         User.Identity.IsAuthenticated)
                    {
 
                        @if (User.IsInRole("Administrador"))
                        {
 
                            <li class="nav-item">
 
                                <a class="nav-link"
                                   asp-controller="Dashboard"
                                   asp-action="Index">
 
                                    Dashboard
 
                                </a>
 
                            </li>
 
 
                            <li class="nav-item">
 
                                <a class="nav-link"
                                   asp-controller="ServiciosVeterinarios"
                                   asp-action="Index">
 
                                    Servicios
 
                                </a>
 
                            </li>
 
 
                            <li class="nav-item">
 
                                <a class="nav-link"
                                   asp-controller="AdminCitas"
                                   asp-action="Index">
 
                                    Citas
 
                                </a>
 
                            </li>
 
 
                            <li class="nav-item dropdown">
 
                                <a class="nav-link dropdown-toggle"
                                   href="#"
                                   data-bs-toggle="dropdown">
 
                                    Reportes
 
                                </a>
 
 
                                <ul class="dropdown-menu">
 
                                    <li>
 
                                        <a class="dropdown-item"
                                           asp-controller="Reportes"
                                           asp-action="CitasGenerales">
 
                                            Listado general de citas
 
                                        </a>
 
                                    </li>
 
 
                                    <li>
 
                                        <a class="dropdown-item"
                                           asp-controller="Reportes"
                                           asp-action="ServiciosSolicitados">
 
                                            Servicios más solicitados
 
                                        </a>
 
                                    </li>
 
                                </ul>
 
                            </li>
 
                        }
 
 
                        @if (User.IsInRole("Cliente"))
                        {
 
                            <li class="nav-item">
 
                                <a class="nav-link"
                                   asp-controller="ServiciosVeterinarios"
                                   asp-action="Index">
 
                                    Servicios
 
                                </a>
 
                            </li>
 
 
                            <li class="nav-item">
 
                                <a class="nav-link"
                                   asp-controller="Mascotas"
                                   asp-action="Index">
 
                                    Mis Mascotas
 
                                </a>
 
                            </li>
 
 
                            <li class="nav-item">
 
                                <a class="nav-link"
                                   asp-controller="Citas"
                                   asp-action="Create">
 
                                    Solicitar Cita
 
                                </a>
 
                            </li>
 
 
                            <li class="nav-item">
 
                                <a class="nav-link"
                                   asp-controller="Citas"
                                   asp-action="Index">
 
                                    Mis Citas
 
                                </a>
 
                            </li>
 
                        }
 
                    }
 
                </ul>
 
 
                <partial name="_LoginPartial" />
 
            </div>
 
        </div>
 
    </nav>
 
</header>
 
 
<main class="main-content">
 
    <div class="container-fluid px-lg-5 py-4">
 
        @RenderBody()
 
    </div>
 
</main>
 
 
<footer class="vet-footer">
 
    <div class="container-fluid px-lg-5">
 
        © 2026 VetCare - Clínica Veterinaria
 
    </div>
 
</footer>
 
 
<script src="~/lib/jquery/dist/jquery.min.js"></script>
 
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
 
<script src="~/js/site.js"
        asp-append-version="true"></script>
 
@await RenderSectionAsync(
    "Scripts",
    required: false
)
 
</body>
 
</html>
 