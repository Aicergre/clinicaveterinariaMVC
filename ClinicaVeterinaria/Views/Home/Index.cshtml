@{
    ViewData["Title"] = "Inicio";
}

@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    @if (User.IsInRole("Administrador"))
    {
        <!-- ============================= -->
        <!-- INICIO ADMINISTRADOR -->
        <!-- ============================= -->

        <div class="container-fluid py-4">

            <div class="p-5 mb-4 bg-white rounded-4 shadow-sm">

                <div class="row align-items-center">

                    <div class="col-lg-7">

                        <span class="badge bg-light text-dark mb-3">
                            🐾 Clínica Veterinaria
                        </span>

                        <h1 class="display-5 fw-bold">
                            Bienvenido a
                            <span style="color:#168a9a;">
                                VetCare
                            </span>
                        </h1>

                        <p class="lead text-muted">
                            Administra los servicios, citas, mascotas
                            y reportes de la clínica veterinaria.
                        </p>

                        <div class="mt-4">

                            <a asp-controller="Dashboard"
                               asp-action="Index"
                               class="btn btn-primary me-2">

                                Ir al Dashboard

                            </a>

                            <a asp-controller="ServiciosVeterinarios"
                               asp-action="Index"
                               class="btn btn-outline-primary">

                                Gestionar Servicios

                            </a>

                        </div>

                    </div>

                    <div class="col-lg-5 text-center">

                        <div style="font-size:130px;">
                            🐶
                        </div>

                    </div>

                </div>

            </div>


            <!-- TARJETAS ADMIN -->

            <div class="row g-4">

                <div class="col-md-6 col-lg-3">

                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="text-decoration-none">

                        <div class="card border-0 shadow-sm h-100">

                            <div class="card-body p-4">

                                <div style="font-size:36px;">
                                    📊
                                </div>

                                <h5 class="fw-bold mt-3 text-dark">
                                    Dashboard
                                </h5>

                                <p class="text-muted mb-0">
                                    Consulta la información general
                                    de la clínica.
                                </p>

                            </div>

                        </div>

                    </a>

                </div>


                <div class="col-md-6 col-lg-3">

                    <a asp-controller="ServiciosVeterinarios"
                       asp-action="Index"
                       class="text-decoration-none">

                        <div class="card border-0 shadow-sm h-100">

                            <div class="card-body p-4">

                                <div style="font-size:36px;">
                                    🩺
                                </div>

                                <h5 class="fw-bold mt-3 text-dark">
                                    Servicios
                                </h5>

                                <p class="text-muted mb-0">
                                    Administra los servicios
                                    veterinarios disponibles.
                                </p>

                            </div>

                        </div>

                    </a>

                </div>


                <div class="col-md-6 col-lg-3">

                    <a asp-controller="AdminCitas"
                       asp-action="Index"
                       class="text-decoration-none">

                        <div class="card border-0 shadow-sm h-100">

                            <div class="card-body p-4">

                                <div style="font-size:36px;">
                                    📅
                                </div>

                                <h5 class="fw-bold mt-3 text-dark">
                                    Gestión de Citas
                                </h5>

                                <p class="text-muted mb-0">
                                    Consulta y administra todas
                                    las citas registradas.
                                </p>

                            </div>

                        </div>

                    </a>

                </div>


                <div class="col-md-6 col-lg-3">

                    <div class="card border-0 shadow-sm h-100">

                        <div class="card-body p-4">

                            <div style="font-size:36px;">
                                📈
                            </div>

                            <h5 class="fw-bold mt-3">
                                Administración
                            </h5>

                            <p class="text-muted mb-0">
                                Gestión centralizada de VetCare.
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>
    }
    else if (User.IsInRole("Cliente"))
    {
        <!-- ============================= -->
        <!-- INICIO CLIENTE -->
        <!-- ============================= -->

        <div class="container-fluid py-4">

            <div class="p-5 mb-4 bg-white rounded-4 shadow-sm">

                <div class="row align-items-center">

                    <div class="col-lg-7">

                        <span class="badge bg-light text-dark mb-3">
                            🐾 Clínica Veterinaria
                        </span>

                        <h1 class="display-5 fw-bold">
                            Bienvenido a
                            <span style="color:#168a9a;">
                                VetCare
                            </span>
                        </h1>

                        <p class="lead text-muted">
                            Registra tus mascotas, consulta nuestros
                            servicios veterinarios y agenda citas fácilmente.
                        </p>

                        <div class="mt-4">

                            <a asp-controller="Mascotas"
                               asp-action="Index"
                               class="btn btn-primary me-2">

                                Mis Mascotas

                            </a>

                            <a asp-controller="Citas"
                               asp-action="Create"
                               class="btn btn-outline-primary">

                                Solicitar Cita

                            </a>

                        </div>

                    </div>


                    <div class="col-lg-5 text-center">

                        <div style="font-size:130px;">
                            🐶
                        </div>

                    </div>

                </div>

            </div>


            <!-- TARJETAS CLIENTE -->

            <div class="row g-4">


                <!-- SERVICIOS -->

                <div class="col-md-4">

                    <a asp-controller="ServiciosVeterinarios"
                       asp-action="Index"
                       class="text-decoration-none">

                        <div class="card border-0 shadow-sm h-100">

                            <div class="card-body p-4">

                                <div style="font-size:38px;">
                                    🩺
                                </div>

                                <h5 class="fw-bold mt-3 text-dark">
                                    Servicios Veterinarios
                                </h5>

                                <p class="text-muted mb-0">
                                    Consulta los servicios disponibles
                                    para el cuidado de tu mascota.
                                </p>

                            </div>

                        </div>

                    </a>

                </div>


                <!-- MIS MASCOTAS -->

                <div class="col-md-4">

                    <a asp-controller="Mascotas"
                       asp-action="Index"
                       class="text-decoration-none">

                        <div class="card border-0 shadow-sm h-100">

                            <div class="card-body p-4">

                                <div style="font-size:38px;">
                                    🐾
                                </div>

                                <h5 class="fw-bold mt-3 text-dark">
                                    Mis Mascotas
                                </h5>

                                <p class="text-muted mb-0">
                                    Registra y administra la información
                                    de tus mascotas.
                                </p>

                            </div>

                        </div>

                    </a>

                </div>


                <!-- MIS CITAS -->

                <div class="col-md-4">

                    <a asp-controller="Citas"
                       asp-action="Index"
                       class="text-decoration-none">

                        <div class="card border-0 shadow-sm h-100">

                            <div class="card-body p-4">

                                <div style="font-size:38px;">
                                    📅
                                </div>

                                <h5 class="fw-bold mt-3 text-dark">
                                    Mis Citas
                                </h5>

                                <p class="text-muted mb-0">
                                    Consulta las citas veterinarias
                                    de tus mascotas.
                                </p>

                            </div>

                        </div>

                    </a>

                </div>

            </div>

        </div>
    }
}
else
{
    <!-- ============================= -->
    <!-- USUARIO SIN INICIAR SESIÓN -->
    <!-- ============================= -->

    <div class="container py-5">

        <div class="text-center">

            <div style="font-size:100px;">
                🐾
            </div>

            <h1 class="display-4 fw-bold">
                Bienvenido a VetCare
            </h1>

            <p class="lead text-muted">
                Sistema web para la gestión de una clínica veterinaria.
            </p>

            <div class="mt-4">

                <a asp-area="Identity"
                   asp-page="/Account/Login"
                   class="btn btn-primary">

                    Iniciar sesión

                </a>

                <a asp-area="Identity"
                   asp-page="/Account/Register"
                   class="btn btn-outline-primary">

                    Crear cuenta

                </a>

            </div>

        </div>

    </div>
}