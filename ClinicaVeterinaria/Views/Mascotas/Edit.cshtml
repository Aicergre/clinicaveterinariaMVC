@model ClinicaVeterinaria.Models.Mascota

@{
    ViewData["Title"] = "Editar Mascota";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <h2 class="fw-bold mb-4">
                        ✏️ Editar Mascota
                    </h2>

                    <form asp-action="Edit"
                          method="post">

                        <input type="hidden"
                               asp-for="Id" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger">
                        </div>

                        <div class="mb-3">

                            <label asp-for="Nombre"
                                   class="form-label">
                                Nombre
                            </label>

                            <input asp-for="Nombre"
                                   class="form-control" />

                            <span asp-validation-for="Nombre"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Especie"
                                   class="form-label">
                                Especie
                            </label>

                            <select asp-for="Especie"
                                    class="form-select">

                                <option value="Perro">Perro</option>
                                <option value="Gato">Gato</option>
                                <option value="Conejo">Conejo</option>
                                <option value="Ave">Ave</option>
                                <option value="Otro">Otro</option>

                            </select>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Raza"
                                   class="form-label">
                                Raza
                            </label>

                            <input asp-for="Raza"
                                   class="form-control" />

                        </div>

                        <button type="submit"
                                class="btn btn-primary">
                            Guardar Cambios
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Cancelar
                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>