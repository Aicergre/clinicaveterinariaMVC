@model IEnumerable<ClinicaVeterinaria.Models.ServicioVeterinario>
 
@{
    ViewData["Title"] = "Servicios Veterinarios";
}
 
<div class="admin-header mb-4">
 
    <div>
        <h1>Servicios Veterinarios</h1>
        <p>
            Gestiona los servicios disponibles de VetCare.
        </p>
    </div>
 
    @if (User.IsInRole("Administrador"))
    {
        <a asp-action="Create"
           class="btn btn-primary">
            + Nuevo Servicio
        </a>
    }
 
</div>
 
@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}
 
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}
 
<div class="admin-panel">
 
    <div class="panel-header">
        <div>
            <h4>Servicios registrados</h4>
            <span>
                @Model.Count() servicio(s)
            </span>
        </div>
    </div>
 
    @if (!Model.Any())
    {
        <div class="p-4">
 
            <div class="alert alert-info mb-0">
                Todavía no existen servicios veterinarios registrados.
            </div>
 
        </div>
    }
    else
    {
        <div class="table-responsive">
 
            <table class="table table-hover align-middle">
 
                <thead>
                    <tr>
                        <th>Servicio</th>
                        <th>Descripción</th>
                        <th>Precio</th>
                        <th style="width:250px;">
                            Acciones
                        </th>
                    </tr>
                </thead>
 
                <tbody>
 
                    @foreach (var item in Model)
                    {
                        <tr>
 
                            <td>
                                <strong>
                                    🩺 @item.Nombre
                                </strong>
                            </td>
 
                            <td>
                                @item.Descripcion
                            </td>
 
                            <td>
                                <strong>
                                    Bs. @item.Precio.ToString("0.00")
                                </strong>
                            </td>
 
                            <td>
 
                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Ver
                                </a>
 
                                @if (User.IsInRole("Administrador"))
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-warning">
                                        Editar
                                    </a>
 
                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-danger">
                                        Eliminar
                                    </a>
                                }
 
                            </td>
 
                        </tr>
                    }
 
                </tbody>
 
            </table>
 
        </div>
    }
 
</div>
 