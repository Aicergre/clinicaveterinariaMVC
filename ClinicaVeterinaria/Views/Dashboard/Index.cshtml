@model ClinicaVeterinaria.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="admin-header mb-4">
    <div>
        <h1>Dashboard</h1>
        <p>
            Resumen general de la Clínica Veterinaria
        </p>
    </div>

    <div class="admin-badge">
        Administrador
    </div>
</div>

 
<div class="row g-4 mb-4">

    <div class="col-md-6 col-xl-3">
        <div class="dashboard-card">
            <div class="dashboard-icon">
                🩺
            </div>

            <div>
                <span>Servicios</span>
                <h2>@Model.TotalServicios</h2>
            </div>
        </div>
    </div>

 
    <div class="col-md-6 col-xl-3">
        <div class="dashboard-card">
            <div class="dashboard-icon">
                🐾
            </div>

            <div>
                <span>Mascotas</span>
                <h2>@Model.TotalMascotas</h2>
            </div>
        </div>
    </div>

 
    <div class="col-md-6 col-xl-3">
        <div class="dashboard-card">
            <div class="dashboard-icon">
                👥
            </div>

            <div>
                <span>Usuarios</span>
                <h2>@Model.TotalUsuarios</h2>
            </div>
        </div>
    </div>

 
    <div class="col-md-6 col-xl-3">
        <div class="dashboard-card">
            <div class="dashboard-icon">
                📅
            </div>

            <div>
                <span>Citas</span>
                <h2>@Model.TotalCitas</h2>
            </div>
        </div>
    </div>

</div>

 
<div class="row g-4 mb-4">

    <div class="col-md-4">

        <div class="status-card status-pendiente">

            <span>Pendientes</span>

            <h3>
                @Model.CitasPendientes
            </h3>

        </div>

    </div>

 
    <div class="col-md-4">

        <div class="status-card status-atendida">

            <span>Atendidas</span>

            <h3>
                @Model.CitasAtendidas
            </h3>

        </div>

    </div>

 
    <div class="col-md-4">

        <div class="status-card status-cancelada">

            <span>Canceladas</span>

            <h3>
                @Model.CitasCanceladas
            </h3>

        </div>

    </div>

</div>

 
<div class="row g-4">

    <div class="col-lg-7">

        <div class="admin-panel">

            <div class="panel-header">

                <div>
                    <h4>Citas por mes</h4>
                    <span>
                        Cantidad de citas registradas
                    </span>
                </div>

            </div>

            <div class="p-3">

                <canvas id="graficoCitas"
                        height="120">
                </canvas>

            </div>

        </div>

    </div>

 
    <div class="col-lg-5">

        <div class="admin-panel">

            <div class="panel-header">

                <div>
                    <h4>Últimas citas</h4>
                    <span>
                        Actividad reciente
                    </span>
                </div>

            </div>

 
            <div class="table-responsive">

                <table class="table align-middle mb-0">

                    <thead>

                        <tr>
                            <th>Mascota</th>
                            <th>Fecha</th>
                            <th>Estado</th>
                        </tr>

                    </thead>

 
                    <tbody>

                        @foreach (var cita in Model.UltimasCitas)
                        {
                            <tr>

                                <td>
                                    @cita.Mascota?.Nombre
                                </td>

                                <td>
                                    @cita.Fecha.ToString("dd/MM/yyyy")
                                </td>

                                <td>

                                    @if (cita.Estado == "Pendiente")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pendiente
                                        </span>
                                    }
                                    else if (cita.Estado == "Atendida")
                                    {
                                        <span class="badge bg-success">
                                            Atendida
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Cancelada
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

 
@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        const ctx =
            document.getElementById('graficoCitas');

        new Chart(ctx, {

            type: 'bar',

            data: {

                labels:
                @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(
                                Model.Meses
                        )
                ),

                datasets: [{

                    label: 'Citas',

                    data:
                    @Html.Raw(
                            System.Text.Json.JsonSerializer.Serialize(
                                    Model.CantidadCitas
                            )
                    ),

                    borderWidth: 1

                }]

            },

            options: {

                responsive: true,

                scales: {

                    y: {
                        beginAtZero: true,
                        ticks: {
                            precision: 0
                        }
                    }

                }

            }

        });

    </script>

}

 